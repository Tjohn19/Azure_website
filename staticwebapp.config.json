{
  "routes": [
    {
      "route": "/*",
      "serve": "index.html",
      "statusCode": 200
    },
    {
      "route": "/pages/*",
      "serve": "/pages/index.html",
      "statusCode": 200
    },
    {
      "route": "/css/*",
      "serve": "/css/*"
    },
    {
      "route": "/js/*",
      "serve": "/js/*"
    },
    {
      "route": "/images/*",
      "serve": "/images/*"
    }
  ],
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": ["/images/*", "/css/*", "/js/*", "*.json"]
  },
  "trailingSlash": "auto",
  "globalHeaders": [
    {
      "path": "/*",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "name": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "name": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "name": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "path": "/css/*",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    },
    {
      "path": "/js/*",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    },
    {
      "path": "/images/*",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ]
}
